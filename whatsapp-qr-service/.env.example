# Port this service listens on
PORT=3200

# Shared secret Laravel must send as "Authorization: Bearer <SHARED_SECRET>"
# on every request to this service, and that this service sends back the
# same way when calling LARAVEL_WEBHOOK_URL.
#
# If left empty/unset, this service SKIPS auth checking on incoming requests
# (dev-convenience fallback). Always set this in any shared/staging/production
# environment.
SHARED_SECRET=

# Laravel endpoint this service POSTs events to (message received / status change).
# Example: https://your-app.example.com/api/whatsapp/webhook
LARAVEL_WEBHOOK_URL=
